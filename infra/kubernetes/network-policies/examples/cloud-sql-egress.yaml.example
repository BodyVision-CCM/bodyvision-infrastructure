# Remplacer le CIDR par l'IP privee /32 du Cloud SQL provisionne dans SCRUM-49.
# Ajouter ce fichier renseigne aux resources d'un overlay avant le deploiement des API.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-cloud-sql
  namespace: bodyvision
spec:
  podSelector:
    matchExpressions:
      - key: app.kubernetes.io/name
        operator: In
        values: [users, analytics-api, analytics-worker]
  policyTypes: [Egress]
  egress:
    - to:
        - ipBlock:
            cidr: REPLACE_WITH_CLOUD_SQL_PRIVATE_IP/32
      ports:
        # Garder uniquement le port du mode d'acces retenu :
        # 3307 pour Cloud SQL Auth Proxy / Connectors, ou 5432 en acces PostgreSQL direct TLS.
        - protocol: TCP
          port: 3307
