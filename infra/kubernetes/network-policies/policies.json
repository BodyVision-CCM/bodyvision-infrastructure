                    "k8s-app": "kube-dns"
                  }
                }
              },
              {
                "ipBlock": {
                  "cidr": "169.254.20.10/32"
                }
              }
            ],
            "ports": [
              {
                "protocol": "UDP",
                "port": 53
              },
              {
                "protocol": "TCP",
                "port": 53
              }
            ]
          },
          {
            "to": [
              {
                "ipBlock": {
                  "cidr": "169.254.169.254/32"
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 80
              },
              {
                "protocol": "TCP",
                "port": 8080
              }
            ]
          }
        ]
